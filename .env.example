# --- Local Docker (recommended for day-to-day) ---
#   bun run db:up
#   cp .env.example .env.local
#   bun run db:migrate
#   bun run dev:local
#
POSTGRES_URL=postgresql://trousseau:trousseau@localhost:5432/trousseau
POSTGRES_URL_NON_POOLING=postgresql://trousseau:trousseau@localhost:5432/trousseau
LOCAL_BLOB_DIR=./public/.local-blob
LOCAL_BLOB_PUBLIC_URL=http://localhost:3000/.local-blob
# BLOB_READ_WRITE_TOKEN=   # only needed if LOCAL_BLOB_DIR is unset

# --- Production / Vercel-linked project ---
#   vercel link
#   vercel integration add neon ...
#   vercel storage create/connect trousseau-blob ...
#   vercel env pull .env.local
#
# Required for cloud share API handlers without LOCAL_BLOB_DIR:
# POSTGRES_URL=
# BLOB_READ_WRITE_TOKEN=
