#!/usr/bin/env bash
# Mirrors the GitHub app CI gate on every commit.
set -e
LOG_FILE="${TMPDIR:-/tmp}/trousseau-pre-commit-$(date +%Y%m%dT%H%M%S).log"
echo "→ bun run check"
echo "  full output: $LOG_FILE"
set +e
bun run check 2>&1 | tee "$LOG_FILE"
status=${PIPESTATUS[0]}
set -e
if [[ $status -ne 0 ]]; then
  echo "✗ bun run check failed (exit $status). Full output: $LOG_FILE"
fi
exit "$status"
